require 'sidekiq'
require 'rubymcp/background'

RubyMCP::TaskExecuteJob.queue_adapter = :sidekiq

RubyMCP.configure do |config|
  config.task_owner = ->(context) { context.fetch(:current_account).to_global_id.to_s }
  config.task_context_dump = ->(context) { { 'account_id' => context.fetch(:current_account).id } }
  config.task_context_load = lambda do |data|
    account = <%= self.class_name %>.find(data.fetch('account_id'))
    if account.respond_to?(:active_for_authentication?) && !account.active_for_authentication?
      raise RubyMCP::Tool::Error, 'Account is no longer active'
    end
    { current_account: account }
  end
end
